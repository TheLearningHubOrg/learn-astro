---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Counter from '../components/Counter.astro';
import { stages } from '../lib/curriculum';

// Runs once, at build time. Nothing in this fence reaches the browser.
const builtAt = new Date().toISOString().slice(0, 10);
---

<Layout title="Learn Astro" description="A 7-stage Astro curriculum with a runnable starter project">
  <header class="header">
    <div class="badge">Astro &bull; Islands Architecture</div>
    <h1 class="title">Learn Astro</h1>
    <p class="subtitle">
      Pages are rendered to HTML ahead of time. JavaScript is added only to the parts that need it.
    </p>
  </header>

  <Counter label="Vanilla island: a custom element plus a bundled script" start={0} min={-10} max={10} />

  <section>
    <h2>7-stage curriculum</h2>
    <div class="grid">
      {stages.map((s) => (
        <Card stage={`Stage ${s.number}`} title={s.title} description={s.summary} href={`/stages/${s.slug}/`}>
          <ul class="topics">
            {s.topics.map((t) => <li><code>{t}</code></li>)}
          </ul>
        </Card>
      ))}
    </div>
  </section>

  <p class="built">Built on {builtAt}</p>
</Layout>
