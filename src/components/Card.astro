---
interface Props {
  title: string;
  stage: string;
  description: string;
  badge?: string;
}

const { title, stage, description, badge = 'Mastered' } = Astro.props;
---

<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
    <span style="font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: #bc52ee; letter-spacing: 0.05em;">{stage}</span>
    <span style="background: rgba(188, 82, 238, 0.15); color: #bc52ee; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">{badge}</span>
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>
  <slot />
</div>
